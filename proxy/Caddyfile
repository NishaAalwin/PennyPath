# One public address for the whole app, over HTTPS. The page and the API share an origin, so the browser needs no
# CORS and the login cookie can be SameSite=Strict.
#
# SITE_ADDRESS (from .env) defaults to localhost:8443, for which Caddy issues a certificate from its own local CA
# (your browser will warn until you trust it; see docs/operations.md). Set it to a real domain on a host with ports
# 80 and 443 open and Caddy obtains and renews a Let's Encrypt certificate by itself.
{
	admin off
}

{$SITE_ADDRESS:localhost:8443} {
	encode zstd gzip
	header {
		-Server
		# Keep other sites from sharing a browsing context or loading our responses.
		Cross-Origin-Opener-Policy same-origin
		Cross-Origin-Resource-Policy same-origin
	}

	# Tell browsers to use HTTPS only, on a real domain. Not for localhost: the browser remembers HSTS per host name
	# (any port), which would break plain-HTTP dev servers on localhost.
	@public not host localhost 127.0.0.1
	header @public Strict-Transport-Security "max-age=31536000"

	# Caddy replaces any X-Forwarded-* sent by the client, so the API sees the real client address.
	handle /api/* {
		reverse_proxy api:8080
	}

	handle {
		reverse_proxy web:8080
	}
}
