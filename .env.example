# Copy to .env (git-ignored) and fill in real values. Never commit .env.
#
# Generate strong values, e.g. with Git Bash / WSL:
#   openssl rand -base64 48
POSTGRES_PASSWORD=
JWT_KEY=

# Optional. Address the HTTPS proxy serves. Default localhost:8443 uses a local development certificate.
# For a real deployment set your domain (ports 80 and 443 must be open) and Caddy gets a Let's Encrypt certificate.
# SITE_ADDRESS=pennypath.example.com

# Optional. Gmail import (M2). Create an OAuth client of type "Web application" in Google Cloud Console and enable the Gmail API;
# its redirect URI must be exactly GOOGLE_REDIRECT_URI. Steps are in docs/operations.md. Never share or commit the secret.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=https://localhost:8443/api/gmail/callback

# Optional. Outgoing email (verification and password reset). Leave empty to use the local Mailpit catcher
# (inbox at http://127.0.0.1:8025). For a real mail server fill all of these and set SMTP_USE_TLS=true:
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USE_TLS=true
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=PennyPath <no-reply@example.com>
